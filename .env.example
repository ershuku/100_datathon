# Copy to .env and fill in. Never commit .env.

# Comma-separated; give the jury one key via a separate channel. At least 16 chars; the service
# refuses to start with a placeholder. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=change-me

# dummy = fake results marked [ТЕСТОВЫЙ РЕЖИМ]; real = src/pipeline/analyzer.py:create_analyzer
PIPELINE=dummy
# PIPELINE_FACTORY=pipeline.analyzer:create_analyzer
# Real analyzer (detector + rule engine): weights path inside the container, score threshold, sampling fps
# DETECTOR_WEIGHTS=/models/detector/checkpoint_best_total.pth
# DETECTOR_THRESHOLD=0.35
# DETECTOR_FPS=5
DUMMY_DELAY_SEC=8
# auto | none | violations | review | slow | crash
DUMMY_SCENARIO=auto

# Time budget per job, counted from upload (includes queue wait). The jury limit is 300 s.
JOB_TIMEOUT_SEC=280
EVIDENCE_RESERVE_SEC=20
# At most this many violations per video (earliest kept)
MAX_VIOLATIONS=20
# TODO(team): failed | partial
TIMEOUT_FALLBACK=failed
# TODO(team): report | drop   (events the analyzer marks needs_review)
REVIEW_POLICY=report

WORKER_CONCURRENCY=1
MAX_QUEUE=20
# Slots the anonymous UI may not use, so the jury API is never starved
API_RESERVED_SLOTS=8
# Max UI jobs queued+running at once (API jobs always run first anyway)
UI_MAX_ACTIVE=2
# Jobs with less analysis time left than this fail at once instead of being killed mid-way
MIN_ANALYZE_SEC=10
MAX_CONCURRENT_UPLOADS=3
MIN_FREE_DISK_MB=1024
MAX_VIDEO_SIDE_PX=4096
MAX_FPS=240
MAX_UPLOAD_MB=300
# Video files are deleted this long after the job ends; the JSON result is kept.
FILE_TTL_SEC=3600

# UI routes (no key) are rate-limited per client IP.
UI_UPLOAD_PER_MIN=6
UI_POLL_PER_MIN=120
# none (direct or GPU pod proxy) | xff (behind Caddy) | cloudflare (behind Cloudflare Tunnel)
# Proxy secrets (DOMAIN, TUNNEL_TOKEN) go in deploy.env, not here.
TRUST_PROXY=none

# Local dev on Windows: full paths if ffmpeg is not on PATH
# FFMPEG_BIN=C:/path/to/ffmpeg.exe
# FFPROBE_BIN=C:/path/to/ffprobe.exe
VIDEO_ENCODER=libx264
VIDEO_PRESET=veryfast
NORMALIZE_MAX_SIDE=1280

ENABLE_DOCS=false
LOG_LEVEL=INFO
