{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datathon.local/schemas/job_response.schema.json",
  "title": "GET /api/v1/jobs/{job_id} response",
  "description": "Public jury contract (case brief §10). No additional properties anywhere.",
  "oneOf": [
    { "$ref": "#/$defs/processing" },
    { "$ref": "#/$defs/failed" },
    { "$ref": "#/$defs/done" }
  ],
  "$defs": {
    "job_id": { "type": "string", "minLength": 1 },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status"],
      "properties": {
        "job_id": { "$ref": "#/$defs/job_id" },
        "status": { "const": "processing" }
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "error"],
      "properties": {
        "job_id": { "$ref": "#/$defs/job_id" },
        "status": { "const": "failed" },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "verdict", "violations"],
      "properties": {
        "job_id": { "$ref": "#/$defs/job_id" },
        "status": { "const": "done" },
        "verdict": { "enum": ["violation", "no_violation"] },
        "violations": { "type": "array", "items": { "$ref": "#/$defs/violation" } }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "no_violation" } } },
          "then": { "properties": { "violations": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "verdict": { "const": "violation" } } },
          "then": { "properties": { "violations": { "minItems": 1 } } }
        }
      ]
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timecode_sec", "description", "evidence_frames"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "timecode_sec": { "type": "number", "minimum": 0 },
        "description": { "type": "string", "minLength": 1 },
        "evidence_frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidence_frame" }
        }
      }
    },
    "evidence_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_sec", "image_base64"],
      "properties": {
        "timestamp_sec": { "type": "number", "minimum": 0 },
        "image_base64": {
          "type": "string",
          "description": "JPEG bytes, plain base64 (no data: prefix); JPEG base64 starts with /9j/",
          "pattern": "^/9j/[A-Za-z0-9+/]*={0,2}$"
        }
      }
    }
  }
}
